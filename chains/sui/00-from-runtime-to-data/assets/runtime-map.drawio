        <mxCell id="N02" value="&lt;b&gt;02  组装并签名交易&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#617582&quot;&gt;Transaction / PTB&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Inputs · Commands · Gas&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F4F7F9;strokeColor=#718493;fontColor=#233746;strokeWidth=1.4;fontFamily=PingFang SC;fontSize=17;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="270" width="340" height="82" as="geometry" />
        </mxCell>
        <mxCell id="N03" value="&lt;b&gt;03  网络校验&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#617582&quot;&gt;Network Validation&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Signature / Gas / Input Validity&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F4F7F9;strokeColor=#718493;fontColor=#233746;strokeWidth=1.4;fontFamily=PingFang SC;fontSize=17;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="380" width="340" height="82" as="geometry" />
