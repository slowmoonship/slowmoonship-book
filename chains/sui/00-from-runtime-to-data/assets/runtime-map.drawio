        <mxCell id="N01" value="&lt;b&gt;01  用户操作&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#617582&quot;&gt;User Action&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Alice · Swap 5 SUI → USDC&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F4F7F9;strokeColor=#718493;fontColor=#233746;strokeWidth=1.4;fontFamily=PingFang SC;fontSize=17;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
