        <mxCell id="N04" value="&lt;b&gt;04  网络共识排序&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#617582&quot;&gt;Network Sequencing / Consensus&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;所有交易进入共同网络排序流程&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#EEF4F6;strokeColor=#69828E;fontColor=#233746;strokeWidth=1.4;fontFamily=PingFang SC;fontSize=17;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
