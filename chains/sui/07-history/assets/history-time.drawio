<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="book-figure" name="历史与时间｜Checkpoint and Epoch">
    <mxGraphModel page="1" pageWidth="1000" pageHeight="610" grid="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="历史与时间｜Checkpoint and Epoch" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;strokeColor=none;align=left;fontSize=27;" vertex="1" parent="1">
          <mxGeometry x="25" y="18" width="950" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="执行确认、历史收录与平台摄取为不同观察点" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;strokeColor=none;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="25" y="64" width="950" height="28" as="geometry" />
        </mxCell>
        <mxCell id="n0" value="&lt;b&gt;已执行事务&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Transaction + Effects&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;结果可获得最终确认&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=#ECF5F0;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;" vertex="1" parent="1">
          <mxGeometry x="25" y="135" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;检查点历史&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Checkpoint N&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;交易 Digest + Effects Digest&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=#F2F6FA;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;" vertex="1" parent="1">
          <mxGeometry x="365" y="135" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;后续检查点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Checkpoint N+1&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;引用前一检查点哈希&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=#F2F6FA;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;" vertex="1" parent="1">
          <mxGeometry x="705" y="135" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;网络周期&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Epoch&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;委员会 / 配置的运行背景&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=#FFF6E8;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;" vertex="1" parent="1">
          <mxGeometry x="25" y="355" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;历史时间&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Checkpoint Timestamp&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;不是钱包签名的精确时刻&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=#FFF6E8;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;" vertex="1" parent="1">
          <mxGeometry x="365" y="355" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;平台时间&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Ingested / Updated At&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;观察处理延迟与回填&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=#FFF6E8;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;" vertex="1" parent="1">
          <mxGeometry x="705" y="355" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="收录" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=PingFang SC;fontSize=13;fontColor=#425D73;labelBackgroundColor=#FFFFFF;strokeColor=#7890A3;strokeWidth=1.5;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n0" target="n1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="历史连续性" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=PingFang SC;fontSize=13;fontColor=#425D73;labelBackgroundColor=#FFFFFF;strokeColor=#7890A3;strokeWidth=1.5;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="对应时间" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=PingFang SC;fontSize=13;fontColor=#425D73;labelBackgroundColor=#FFFFFF;strokeColor=#7890A3;strokeWidth=1.5;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n1" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Checkpoint 在执行后组织历史；Epoch 不作为每笔事务必经步骤。Certified history after execution." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;strokeColor=none;align=left;fontSize=14;" vertex="1" parent="1">
