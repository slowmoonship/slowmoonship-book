<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="book-figure" name="资金表示与余额｜Assets and Balances">
    <mxGraphModel page="1" pageWidth="1000" pageHeight="610" grid="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="资金表示与余额｜Assets and Balances" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;strokeColor=none;align=left;fontSize=27;" vertex="1" parent="1">
          <mxGeometry x="25" y="18" width="950" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="总余额需要同一币种、主体与时点 Total balance needs matching scope" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;strokeColor=none;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="25" y="64" width="950" height="28" as="geometry" />
        </mxCell>
        <mxCell id="n0" value="&lt;b&gt;离散资产对象&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Coin&amp;lt;T&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;ID + Balance&amp;lt;T&amp;gt; · 多枚 Coin&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=#ECF5F0;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;" vertex="1" parent="1">
          <mxGeometry x="25" y="135" width="270" height="110" as="geometry" />
