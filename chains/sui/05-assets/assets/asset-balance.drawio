        <mxCell id="n1" value="&lt;b&gt;对象内数值&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Balance&amp;lt;T&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;本身没有独立 Object ID&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=#F2F6FA;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;" vertex="1" parent="1">
