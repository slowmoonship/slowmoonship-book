        <mxCell id="n2" value="&lt;b&gt;地址余额&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Address Balance&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;每地址 / 币种的累加器值&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=#ECF5F0;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;" vertex="1" parent="1">
          <mxGeometry x="705" y="135" width="270" height="110" as="geometry" />
