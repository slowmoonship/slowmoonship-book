        <mxCell id="n0" value="&lt;b&gt;历史主干&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Checkpoints → Transactions&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;序号连接；一对多&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=#F2F6FA;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;" vertex="1" parent="1">
