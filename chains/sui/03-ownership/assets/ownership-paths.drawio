        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=PingFang SC;fontSize=13;fontColor=#425D73;labelBackgroundColor=#FFFFFF;strokeColor=#7890A3;strokeWidth=1.5;endArrow=block;exitX=0.9;exitY=1;entryX=0.5;entryY=0;dashed=1;endArrow=none;" edge="1" parent="1" source="n1" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="网络交易排序不等于对象版本路径。Owned、Shared 不构成两笔独立事务。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;strokeColor=none;align=left;fontSize=14;" vertex="1" parent="1">
