<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="book-figure" name="所有权与执行条件｜Ownership and Execution">
    <mxGraphModel page="1" pageWidth="1000" pageHeight="610" grid="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="所有权与执行条件｜Ownership and Execution" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;strokeColor=none;align=left;fontSize=27;" vertex="1" parent="1">
          <mxGeometry x="25" y="18" width="950" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="上方为共同主线；下方展开对象条件 Object access requirements" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;strokeColor=none;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="25" y="64" width="950" height="28" as="geometry" />
        </mxCell>
        <mxCell id="n0" value="&lt;b&gt;共同网络排序&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Network Sequencing&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;所有事务经过共同共识排序&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=#F2F6FA;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;" vertex="1" parent="1">
          <mxGeometry x="25" y="135" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;对象访问条件&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Object Access&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;授权、访问方式与版本条件&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=#F2F6FA;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;" vertex="1" parent="1">
          <mxGeometry x="365" y="135" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;满足依赖后执行&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Execution Readiness&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;无冲突事务可以并行推进&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=#ECF5F0;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;" vertex="1" parent="1">
          <mxGeometry x="705" y="135" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;精确引用与只读&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Address-Owned / Immutable&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;归属与不可变状态分别解释&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=#FFF6E8;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;" vertex="1" parent="1">
          <mxGeometry x="25" y="355" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;共识对象版本&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Shared / Party&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;共享与单地址权限不同&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=#FFF6E8;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;" vertex="1" parent="1">
          <mxGeometry x="365" y="355" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;父子与包装&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Object-Owned / Wrapped&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;独立存储与嵌套可见性不同&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=17;spacing=10;align=center;verticalAlign=middle;fillColor=#FFF6E8;strokeColor=#76899A;strokeWidth=1.4;fontColor=#243B4D;" vertex="1" parent="1">
          <mxGeometry x="705" y="355" width="270" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="检查条件" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=PingFang SC;fontSize=13;fontColor=#425D73;labelBackgroundColor=#FFFFFF;strokeColor=#7890A3;strokeWidth=1.5;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n0" target="n1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="准备执行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=PingFang SC;fontSize=13;fontColor=#425D73;labelBackgroundColor=#FFFFFF;strokeColor=#7890A3;strokeWidth=1.5;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry" />
