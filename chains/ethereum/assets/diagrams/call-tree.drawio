        <mxCell id="u" parent="1" vertex="1" value="&lt;b&gt;用户到路由器&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;CALL · root []&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;一份签名交易&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=10;fillColor=#EDF3FB;strokeColor=#7890A3;fontColor=#243B4D;">
          <mxGeometry x="40" y="120" width="260" height="108" as="geometry" />
        </mxCell>
        <mxCell id="p" parent="1" vertex="1" value="&lt;b&gt;路由器到池&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;CALL · [0]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;目标上下文执行&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=10;fillColor=#EDF3FB;strokeColor=#7890A3;fontColor=#243B4D;">
          <mxGeometry x="40" y="262" width="260" height="108" as="geometry" />
        </mxCell>
        <mxCell id="s" parent="1" vertex="1" value="&lt;b&gt;读取余额&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;STATICCALL · [0,0]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;静态约束，不是支付&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=10;fillColor=#EDF3FB;strokeColor=#7890A3;fontColor=#243B4D;">
          <mxGeometry x="40" y="404" width="260" height="108" as="geometry" />
        </mxCell>
        <mxCell id="c" parent="1" vertex="1" value="&lt;b&gt;支付或回调&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;CALL · [0,1]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;可以继续生成子调用&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=10;fillColor=#EDF3FB;strokeColor=#7890A3;fontColor=#243B4D;">
