        </mxCell>
        <mxCell id="d" parent="1" vertex="1" value="&lt;b&gt;独立代理示意&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;DELEGATECALL&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;借用代码，保留上下文&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=10;fillColor=#FFF4DF;strokeColor=#7890A3;fontColor=#243B4D;">
          <mxGeometry x="340" y="120" width="260" height="108" as="geometry" />
        </mxCell>
        <mxCell id="v" parent="1" vertex="1" value="&lt;b&gt;代理状态位置&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Proxy Storage&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;日志按上下文归属&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=10;fillColor=#EAF5EF;strokeColor=#7890A3;fontColor=#243B4D;">
