        </mxCell>
        <mxCell id="node-1" parent="1" vertex="1" value="&lt;b&gt;节点本地交易池&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Local Mempool&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;非全球统一&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=10;fillColor=#EDF3FB;strokeColor=#7890A3;fontColor=#243B4D;">
          <mxGeometry x="40" y="262" width="260" height="108" as="geometry" />
        </mxCell>
