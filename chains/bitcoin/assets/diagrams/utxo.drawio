        </mxCell>
        <mxCell id="node-1" parent="1" vertex="1" value="&lt;b&gt;尚未消费&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Unspent&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;进入适用UTXO集合&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=10;fillColor=#EAF5EF;strokeColor=#7890A3;fontColor=#243B4D;">
