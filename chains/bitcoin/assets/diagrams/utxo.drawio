        <mxCell id="node-0" parent="1" vertex="1" value="&lt;b&gt;交易创建输出&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Created&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;金额 + 花费条件&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=10;fillColor=#EDF3FB;strokeColor=#7890A3;fontColor=#243B4D;">
