        </mxCell>
        <mxCell id="node-4" parent="1" vertex="1" value="&lt;b&gt;新输出&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;New Outputs&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;新的Outpoints&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=10;fillColor=#EAF5EF;strokeColor=#7890A3;fontColor=#243B4D;">
          <mxGeometry x="340" y="546" width="260" height="108" as="geometry" />
        </mxCell>
        <mxCell id="node-5" parent="1" vertex="1" value="&lt;b&gt;再次成为未花费&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Unspent Again&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;不是旧输出复活&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=10;fillColor=#EAF5EF;strokeColor=#7890A3;fontColor=#243B4D;">
