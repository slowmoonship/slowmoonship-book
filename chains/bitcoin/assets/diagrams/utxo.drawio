        </mxCell>
        <mxCell id="node-3" parent="1" vertex="1" value="&lt;b&gt;旧输出已花费&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Spent&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;退出集合，历史保留&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=10;fillColor=#FCEDED;strokeColor=#7890A3;fontColor=#243B4D;">
