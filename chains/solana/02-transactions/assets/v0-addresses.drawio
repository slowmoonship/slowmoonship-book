<mxfile host="app.diagrams.net" version="31.3.2"><diagram id="v0-addresses" name="v0 地址解析（legacy / v1 不使用 ALT）"><mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="v0 地址解析（legacy / v1 不使用 ALT）" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172b4d;"><mxGeometry as="geometry" x="30" y="10" width="1200" height="55" /></mxCell><mxCell id="static" value="静态地址（Static Keys）&#10;写入 v0 Message" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#e8f0fe;strokeColor=#4d72b8;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="30" y="90" width="270" height="105" /></mxCell><mxCell id="lookup" value="查找引用（ALT Lookup）&#10;表地址 + writable/readonly 索引" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#e8f0fe;strokeColor=#4d72b8;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="460" y="90" width="270" height="105" /></mxCell><mxCell id="alt" value="地址查找表（ALT Account）&#10;保存可引用的地址" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#e8f0fe;strokeColor=#4d72b8;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="890" y="90" width="270" height="105" /></mxCell><mxCell id="loaded" value="加载地址（Loaded Addresses）&#10;先 writable，再 readonly" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#e8f5ed;strokeColor=#448366;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="460" y="270" width="270" height="105" /></mxCell><mxCell id="resolved" value="完整账户清单（Resolved Keys）&#10;静态 + 加载；保持顺序" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#fff3