<mxfile host="app.diagrams.net" version="31.3.2"><diagram id="wallet-flow" name="资金流分析：不要跳过实体层（示意）"><mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="资金流分析：不要跳过实体层（示意）" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172b4d;"><mxGeometry as="geometry" x="30" y="10" width="1200" height="55" /></mxCell><mxCell id="move" value="资产移动（Movement）&#10;source / destination Token Account" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#f0eafa;strokeColor=#8060a5;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="30" y="90" width="270" height="105" /></mxCell><mxCell id="owner" value="业务授权者（Owner / Authority）&#10;同一 owner 的移动可内部抵消" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#e8f0fe;strokeColor=#4d72b8;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="460" y="90" width="270" height="105" /></mxCell><mxCell id="entity" value="实体归因（Entity Attribution）&#10;需额外证据；地址不等于人" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#fce8e8;strokeColor=#aa5b66;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="890" y="90" width="270" height="105" /></mxCell><mxCell id="stock" value="资产存量（Balance）&#10;时点状态，不能仅由短期流量代替" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#e8f0fe;strokeColor=#4d72b8;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="460" y="270" width="270" height="105" /></mxCell><mxCell id="e0" value="按交易时点关系汇总" edge="1" parent="1" source="move" target="owner" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#59677b;fontFamily=PingFang SC