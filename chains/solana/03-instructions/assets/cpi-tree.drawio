<mxfile host="app.diagrams.net" version="31.3.2"><diagram id="cpi-tree" name="一笔交易内的调用（概念示意，索引非实测）"><mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="一笔交易内的调用（概念示意，索引非实测）" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172b4d;"><mxGeometry as="geometry" x="30" y="10" width="1200" height="55" /></mxCell><mxCell id="tx" value="交易（Transaction）&#10;同一个 tx_id" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#e8f0fe;strokeColor=#4d72b8;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="30" y="90" width="270" height="105" /></mxCell><mxCell id="o1" value="顶层指令（Outer Instruction）&#10;调用程序 A；depth=1" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#e8f5ed;strokeColor=#448366;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="460" y="90" width="270" height="105" /></mxCell><mxCell id="o2" value="另一个顶层指令（Outer）&#10;与前一条顺序执行" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#e8f5ed;strokeColor=#448366;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="30" y="270" width="270" height="105" /></mxCell><mxCell id="in1" value="内层调用（CPI）&#10;A 调用 B；depth=2" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#e8f5ed;strokeColor=#448366;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="890" y="90" width="270" height="105" /></mxCell><mxCell id="in2" value="更深调用（Nested CPI）&#10;B 调用 Token Program；depth=3" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#e8f5ed;strokeColor=#448366;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="890" y="270" width="270" height="105" /></mxCell><mxCell id="trace" value="调用轨迹（Instruction Trace）&#10;归属 outer + 顺序 + stack height" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#f0eafa;strokeColor=#8060a5;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="460" y="450" width="270" height="105" /></mxCell><mxCell id="e0" value="消息中的请求" edge="1" parent="1" source="tx" target="o1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#59677b;fontFamily=PingFang SC;fontSize=15;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="消息中的请求" edge="1" parent="1" source="tx" target="o2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#59677b;fontFamily=PingFang SC;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="调用" edge="1" parent="1" source="o1" target="in1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#59677b;fontFamily=PingFang SC;fontSize=15;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="调用" edge="1" parent="1" source="in1" target="in2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#59677b;fontFamily=PingFang SC;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="同属原顶层指令" edge="1" parent="1" source="in2" target="trace" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#59677b;fontFamily=PingFang SC;fontSize=15;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entr