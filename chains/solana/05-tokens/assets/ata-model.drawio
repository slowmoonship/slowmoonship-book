<mxfile host="app.diagrams.net" version="31.3.2"><diagram id="ata-model" name="ATA 是确定地址的 Token Account（示意）"><mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="ATA 是确定地址的 Token Account（示意）" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172b4d;"><mxGeometry as="geometry" x="30" y="10" width="1200" height="55" /></mxCell><mxCell id="inputs" value="派生输入（Derivation Inputs）&#10;owner + Token Program ID + mint" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#e8f0fe;strokeColor=#4d72b8;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="30" y="90" width="270" height="105" /></mxCell><mxCell id="ata" value="关联账户（ATA）&#10;ATA Program 下的派生地址" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#e8f0fe;strokeColor=#4d72b8;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="460" y="90" width="270" height="105" /></mxCell><mxCell id="state" value="代币状态（Token State）&#10;基础 owner 是对应 Token Program" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#e8f0fe;strokeColor=#4d72b8;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="890" y="90" width="270" height="105" /></mxCell><mxCell id="other" value="其他代币账户（Other Accounts）&#10;同 owner / mint 也可以存在" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#e8f0fe;strokeColor=#4d72b8;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="890" y="270" width="270" height="105" /></mxCell><mxCell id="e0" value="按 ATA 规则派生" edge="1" parent="1" source="inputs" target="ata" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeCol