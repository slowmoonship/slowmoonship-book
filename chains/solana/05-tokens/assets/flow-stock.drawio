<mxfile host="app.diagrams.net" version="31.3.2"><diagram id="flow-stock" name="流量与存量（概念示意）"><mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" page="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="流量与存量（概念示意）" vertex="1" parent="1" style="text;html=0;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172b4d;"><mxGeometry as="geometry" x="30" y="10" width="1200" height="55" /></mxCell><mxCell id="initial" value="期初状态（Opening Balance）&#10;指定时点的账户余额" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#e8f0fe;strokeColor=#4d72b8;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="30" y="90" width="270" height="105" /></mxCell><mxCell id="moves" value="期间动作（Movements）&#10;转账 / mint / burn / 特殊动作" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#f0eafa;strokeColor=#8060a5;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="460" y="90" width="270" height="105" /></mxCell><mxCell id="end" value="期末状态（Closing Balance）&#10;按完整变化关系计算或读取" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#e8f0fe;strokeColor=#4d72b8;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="890" y="90" width="270" height="105" /></mxCell><mxCell id="coverage" value="覆盖核验（Coverage QA）&#10;时间、动作、账户生命周期" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=PingFang SC;fontSize=18;spacing=10;fillColor=#fce8e8;strokeColor=#aa5b66;fontColor=#172b4d;strokeWidth=1.5;"><mxGeometry as="geometry" x="460" y="270" width="270" height="105" /></mxCell><mxCell id="e0" value="起点" edge="1" parent="1" source="initial" target="moves" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#59677b;fontFamily=PingFang SC;fontSize=15;labelBackgroundColor=#ff