          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" parent="1" edge="1" source="n3" target="n5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n0" parent="1" vertex="1" value="&lt;b&gt;外部地址&lt;/b&gt;&lt;br&gt;Outside Set S&lt;br&gt;不自动视为用户" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="50" y="150" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" vertex="1" value="&lt;b&gt;核心合约集合&lt;/b&gt;&lt;br&gt;Set S&lt;br&gt;角色与范围先定义" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="550" y="150" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" vertex="1" value="&lt;b&gt;内部互转&lt;/b&gt;&lt;br&gt;Internal Transfers&lt;br&gt;净外部流量中抵消" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="50" y="330" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" vertex="1" value="&lt;b&gt;边界入/出&lt;/b&gt;&lt;br&gt;External In / Out&lt;br&gt;事件级分类" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="550" y="330" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" vertex="1" value="&lt;b&gt;第一跳模型&lt;/b&gt;&lt;br&gt;Time-Window Attribution&lt;br&gt;资金混合与重复归因风险" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DE;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="50" y="510" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" vertex="1" value="&lt;b&gt;研究输出&lt;/b&gt;&lt;br&gt;Flow / Stock / Judgment&lt;br&gt;流入不等于收入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4EA;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
