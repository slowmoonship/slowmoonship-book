        </mxCell>
        <mxCell id="note" parent="1" vertex="1" value="实线Observed为转移口径；虚线Inferred为时间窗归因。&lt;br&gt;实线：文档/源码关系或标明的Observed；虚线：推断/待核Inferred。" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=PingFang SC;whiteSpace=wrap;">
