        <mxCell id="n5" parent="1" vertex="1" value="&lt;b&gt;收益与发行&lt;/b&gt;&lt;br&gt;Revenue / Emission&lt;br&gt;与用户费用分别分析" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DE;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
