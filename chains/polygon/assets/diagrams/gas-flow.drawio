        </mxCell>
        <mxCell id="n3" parent="1" vertex="1" value="&lt;b&gt;执行费用&lt;/b&gt;&lt;br&gt;Gas Used × Price&lt;br&gt;按原生最小单位计算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F2F8;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
