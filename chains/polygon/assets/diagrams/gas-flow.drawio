        <mxCell id="n0" parent="1" vertex="1" value="&lt;b&gt;Gas Limit&lt;/b&gt;&lt;br&gt;Resource Upper Bound&lt;br&gt;允许上限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
