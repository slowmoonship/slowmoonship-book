        </mxCell>
        <mxCell id="n1" parent="1" vertex="1" value="&lt;b&gt;Gas Used&lt;/b&gt;&lt;br&gt;Actual Resource Use&lt;br&gt;实际消耗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="550" y="150" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" vertex="1" value="&lt;b&gt;有效单价&lt;/b&gt;&lt;br&gt;Effective Gas Price&lt;br&gt;不是Max Fee上界" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
