        <mxCell id="n4" parent="1" vertex="1" value="&lt;b&gt;Base / Priority&lt;/b&gt;&lt;br&gt;Fee Components&lt;br&gt;分配按版本核对" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
