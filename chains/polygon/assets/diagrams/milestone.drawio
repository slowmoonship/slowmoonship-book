        <mxCell id="n0" parent="1" vertex="1" value="&lt;b&gt;Bor区块序列&lt;/b&gt;&lt;br&gt;Consecutive Block Hashes&lt;br&gt;高度与哈希共同定位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
