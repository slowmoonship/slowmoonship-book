<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="bridge-accounting" name="跨链统计怎样避免一笔钱算四次">
    <mxGraphModel page="1" pageWidth="1000" pageHeight="850" grid="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" value="跨链统计怎样避免一笔钱算四次" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=28;fontStyle=1;">
          <mxGeometry x="40" y="20" width="920" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e0" parent="1" edge="1" source="n0" target="n1" value="同一资产流程" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" parent="1" edge="1" source="n2" target="n3" value="同一返回流程" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" parent="1" edge="1" source="n0" target="n4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" parent="1" edge="1" source="n1" target="n4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" parent="1" edge="1" source="n2" target="n4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" parent="1" edge="1" source="n3" target="n4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" parent="1" edge="1" source="n4" target="n5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n0" parent="1" vertex="1" value="&lt;b&gt;锁定&lt;/b&gt;&lt;br&gt;Locked on Root&lt;br&gt;根链库存/发起流量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="50" y="150" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" vertex="1" value="&lt;b&gt;铸造表示&lt;/b&gt;&lt;br&gt;Minted on Child&lt;br&gt;目标到账" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="550" y="150" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" vertex="1" value="&lt;b&gt;销毁表示&lt;/b&gt;&lt;br&gt;Burned on Child&lt;br&gt;返回发起" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="50" y="330" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" vertex="1" value="&lt;b&gt;根链释放&lt;/b&gt;&lt;br&gt;Released on Root&lt;br&gt;返回完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="550" y="330" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" vertex="1" value="&lt;b&gt;消息配对&lt;/b&gt;&lt;br&gt;Message / Exit Identity&lt;br&gt;不是只按金额与时间" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="50" y="510" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" vertex="1" value="&lt;b&gt;桥接账&lt;/b&gt;&lt;br&gt;Initiated / Pending / Done&lt;br&gt;阶段分开统计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4EA;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="550" y="510" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" vertex="1" value="锁定+铸造不可当作双倍经济流入；库存与流量也不能相加。&lt;br&gt;实线：文档/源码关系或标明的Observed；虚线：推断/待核Inferred。" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=PingFang SC;whiteSpace=wrap;">
          <mxGeometry x="40" y="720" width="920" height="115" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
