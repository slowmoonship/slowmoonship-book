        <mxCell id="n5" parent="1" vertex="1" value="&lt;b&gt;研究账本&lt;/b&gt;&lt;br&gt;Transfers + State Checks&lt;br&gt;Rebase不能只累加Transfer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4EA;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
