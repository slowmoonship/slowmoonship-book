        <mxCell id="n0" parent="1" vertex="1" value="&lt;b&gt;用户请求&lt;/b&gt;&lt;br&gt;transfer / transferFrom&lt;br&gt;输入参数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
