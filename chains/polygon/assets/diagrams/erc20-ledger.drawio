        <mxCell id="n4" parent="1" vertex="1" value="&lt;b&gt;供应变化&lt;/b&gt;&lt;br&gt;Mint / Burn / Rebase&lt;br&gt;机制不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
