        </mxCell>
        <mxCell id="n1" parent="1" vertex="1" value="&lt;b&gt;合约检查&lt;/b&gt;&lt;br&gt;Allowance / Fee / Roles&lt;br&gt;具体实现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
