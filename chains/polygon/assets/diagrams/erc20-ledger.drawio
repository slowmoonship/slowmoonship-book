        </mxCell>
        <mxCell id="n3" parent="1" vertex="1" value="&lt;b&gt;Transfer事件&lt;/b&gt;&lt;br&gt;Log Identity + Raw Amount&lt;br&gt;按decimals解释" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F2F8;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
