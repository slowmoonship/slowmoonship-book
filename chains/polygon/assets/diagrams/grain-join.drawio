        <mxCell id="e1" parent="1" edge="1" source="n1" target="n2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" parent="1" edge="1" source="n0" target="n3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" parent="1" edge="1" source="n1" target="n3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" parent="1" edge="1" source="n3" target="n4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" parent="1" edge="1" source="n4" target="n5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n0" parent="1" vertex="1" value="&lt;b&gt;三条Trace&lt;/b&gt;&lt;br&gt;3 Execution Frames&lt;br&gt;同一tx_hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="50" y="150" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" vertex="1" value="&lt;b&gt;四条Log&lt;/b&gt;&lt;br&gt;4 Event Logs&lt;br&gt;同一tx_hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="550" y="150" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" vertex="1" value="&lt;b&gt;直接连接&lt;/b&gt;&lt;br&gt;3 × 4 = 12 Rows&lt;br&gt;费用会被重复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DE;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="50" y="330" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" vertex="1" value="&lt;b&gt;分别预聚合&lt;/b&gt;&lt;br&gt;One Row per Transaction&lt;br&gt;trace_count / log_count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="550" y="330" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" vertex="1" value="&lt;b&gt;交易表连接&lt;/b&gt;&lt;br&gt;Transaction-Level Join&lt;br&gt;保留真正交易粒度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="50" y="510" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" vertex="1" value="&lt;b&gt;校验&lt;/b&gt;&lt;br&gt;Counts + Amount Conservation&lt;br&gt;不是SUM DISTINCT补救" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4EA;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="550" y="510" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" vertex="1" value="十二行是连接组合，不是十二笔交易；合成示例明确标识。&lt;br&gt;实线：文档/源码关系或标明的Observed；虚线：推断/待核Inferred。" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=PingFang SC;whiteSpace=wrap;">
          <mxGeometry x="40" y="720" width="920" height="115" as="geometry" />
        </mxCell>
