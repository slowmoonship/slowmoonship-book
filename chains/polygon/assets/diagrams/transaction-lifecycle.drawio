<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="transaction-lifecycle" name="钱包显示成功之后发生了什么">
    <mxGraphModel page="1" pageWidth="1000" pageHeight="850" grid="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" value="钱包显示成功之后发生了什么" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=28;fontStyle=1;">
          <mxGeometry x="40" y="20" width="920" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e0" parent="1" edge="1" source="n0" target="n1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" parent="1" edge="1" source="n1" target="n2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" parent="1" edge="1" source="n2" target="n3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" parent="1" edge="1" source="n3" target="n4" value="后续承诺" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" parent="1" edge="1" source="n4" target="n5" value="仅相关跨链流程" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n0" parent="1" vertex="1" value="&lt;b&gt;签名提交&lt;/b&gt;&lt;br&gt;Signed Transaction&lt;br&gt;钱包→RPC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="50" y="150" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" vertex="1" value="&lt;b&gt;Bor执行&lt;/b&gt;&lt;br&gt;Execution&lt;br&gt;成功或回退" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="550" y="150" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" vertex="1" value="&lt;b&gt;回执可见&lt;/b&gt;&lt;br&gt;Receipt Available&lt;br&gt;执行状态、Gas、Log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F2F8;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="50" y="330" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" vertex="1" value="&lt;b&gt;Milestone&lt;/b&gt;&lt;br&gt;Local Finality&lt;br&gt;确认连续Bor历史" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4EA;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="550" y="330" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" vertex="1" value="&lt;b&gt;Checkpoint&lt;/b&gt;&lt;br&gt;L1 Commitment&lt;br&gt;另行提交Ethereum" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="50" y="510" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" vertex="1" value="&lt;b&gt;桥退出完成&lt;/b&gt;&lt;br&gt;Bridge Exit Completed&lt;br&gt;证明与根链释放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4EA;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="550" y="510" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" vertex="1" value="普通转账无需走完桥退出路线；本地最终确认不等待Checkpoint。&lt;br&gt;实线：文档/源码关系或标明的Observed；虚线：推断/待核Inferred。" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=PingFang SC;whiteSpace=wrap;">
          <mxGeometry x="40" y="720" width="920" height="115" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>