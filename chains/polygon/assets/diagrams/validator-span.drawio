        </mxCell>
        <mxCell id="n3" parent="1" vertex="1" value="&lt;b&gt;Span指派&lt;/b&gt;&lt;br&gt;Span Assignment&lt;br&gt;一段Bor高度范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="550" y="330" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" vertex="1" value="&lt;b&gt;单一生产者&lt;/b&gt;&lt;br&gt;One Producer per Span&lt;br&gt;Rio后实际签发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="50" y="510" width="400" height="120" as="geometry" />
