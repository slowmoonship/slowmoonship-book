        <mxCell id="e5" parent="1" edge="1" source="n0" target="n5" value="共识" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
