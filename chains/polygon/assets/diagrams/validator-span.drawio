        <mxCell id="n0" parent="1" vertex="1" value="&lt;b&gt;验证者集合&lt;/b&gt;&lt;br&gt;Active Validators&lt;br&gt;按投票权参与" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="50" y="150" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" vertex="1" value="&lt;b&gt;生产者投票&lt;/b&gt;&lt;br&gt;Producer Votes&lt;br&gt;加权选择合格池" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="550" y="150" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" vertex="1" value="&lt;b&gt;生产者池&lt;/b&gt;&lt;br&gt;Eligible Producer Pool&lt;br&gt;不等于全部验证者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
