        <mxCell id="n5" parent="1" vertex="1" value="&lt;b&gt;验证与恢复&lt;/b&gt;&lt;br&gt;Validation / Rotation&lt;br&gt;Heimdall确认与故障切换" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4EA;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
