        <mxCell id="e4" parent="1" edge="1" source="n4" target="n5" value="需其他输入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n0" parent="1" vertex="1" value="&lt;b&gt;内部gons&lt;/b&gt;&lt;br&gt;Internal Units&lt;br&gt;账户份额" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="50" y="150" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" vertex="1" value="&lt;b&gt;Rebase输入&lt;/b&gt;&lt;br&gt;Profit / Prior Supply&lt;br&gt;改变总量与gons换算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="550" y="150" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" vertex="1" value="&lt;b&gt;显示余额&lt;/b&gt;&lt;br&gt;balanceOf / 9 Decimals&lt;br&gt;可无逐账户Transfer变化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="50" y="330" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" vertex="1" value="&lt;b&gt;LogRebase比率&lt;/b&gt;&lt;br&gt;rebase / 1e18&lt;br&gt;与余额单位不同" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="550" y="330" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" vertex="1" value="&lt;b&gt;index&lt;/b&gt;&lt;br&gt;index_raw / 1e9&lt;br&gt;静态持有模型输入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="50" y="510" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" vertex="1" value="&lt;b&gt;经济价值&lt;/b&gt;&lt;br&gt;Price / Fees / Liquidity&lt;br&gt;不能由数量直接推出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DE;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="550" y="510" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" vertex="1" value="已取得源码与历史事件；数量增长不是外部DAI自动增加。&lt;br&gt;实线：文档/源码关系或标明的Observed；虚线：推断/待核Inferred。" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontFamily=PingFang SC;whiteSpace=wrap;">
