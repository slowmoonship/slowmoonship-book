        </mxCell>
        <mxCell id="n2" parent="1" vertex="1" value="&lt;b&gt;Heimdall v2&lt;/b&gt;&lt;br&gt;Consensus &amp;amp; Coordination&lt;br&gt;验证者、Span、Milestone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
