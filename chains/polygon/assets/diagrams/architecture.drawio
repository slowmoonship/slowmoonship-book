        <mxCell id="n4" parent="1" vertex="1" value="&lt;b&gt;检查点承诺&lt;/b&gt;&lt;br&gt;Checkpoint Commitment&lt;br&gt;跨链证明所用历史承诺" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F2F8;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
