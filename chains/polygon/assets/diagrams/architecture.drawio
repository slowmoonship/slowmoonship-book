        <mxCell id="n3" parent="1" vertex="1" value="&lt;b&gt;Bor执行&lt;/b&gt;&lt;br&gt;Bor / EVM&lt;br&gt;交易、状态、回执" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
