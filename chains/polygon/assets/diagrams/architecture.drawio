        <mxCell id="e5" parent="1" edge="1" source="n2" target="n5" value="区块序列确认" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#6F7E99;fontSize=14;labelBackgroundColor=#FFFFFF;dashed=0;">
