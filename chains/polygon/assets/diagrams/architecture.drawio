        <mxCell id="n0" parent="1" vertex="1" value="&lt;b&gt;Ethereum合约&lt;/b&gt;&lt;br&gt;Ethereum Contracts&lt;br&gt;质押、检查点、桥根合约" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
