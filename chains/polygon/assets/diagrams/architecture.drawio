        <mxCell id="n1" parent="1" vertex="1" value="&lt;b&gt;用户钱包&lt;/b&gt;&lt;br&gt;Wallet&lt;br&gt;签名与提交" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
