        <mxCell id="n5" parent="1" vertex="1" value="&lt;b&gt;研究口径&lt;/b&gt;&lt;br&gt;Transfers / Trades / Value&lt;br&gt;各自说明单位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4EA;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
