        </mxCell>
        <mxCell id="n1" parent="1" vertex="1" value="&lt;b&gt;标准数量&lt;/b&gt;&lt;br&gt;amount&lt;br&gt;不要重复缩放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
          <mxGeometry x="550" y="150" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" vertex="1" value="&lt;b&gt;历史价格&lt;/b&gt;&lt;br&gt;Price + Time + Source&lt;br&gt;缺价不等于零" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
