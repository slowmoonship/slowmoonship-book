        <mxCell id="n3" parent="1" vertex="1" value="&lt;b&gt;美元估值&lt;/b&gt;&lt;br&gt;amount × price&lt;br&gt;连接不能一对多膨胀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F2F8;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
