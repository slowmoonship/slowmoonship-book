        <mxCell id="n4" parent="1" vertex="1" value="&lt;b&gt;池子状态&lt;/b&gt;&lt;br&gt;Reserves + Fees&lt;br&gt;限制实际退出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
