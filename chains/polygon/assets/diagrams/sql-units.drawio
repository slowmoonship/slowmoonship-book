        <mxCell id="n0" parent="1" vertex="1" value="&lt;b&gt;原始整数&lt;/b&gt;&lt;br&gt;amount_raw&lt;br&gt;保留精度依据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1FB;strokeColor=#9AAAC3;fontFamily=PingFang SC;fontSize=19;spacing=12;">
