        <mxCell id="n0" parent="1" vertex="1" value="&lt;b&gt;三条独立账本&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;C / P / X&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;共享特殊网络归属&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=10;fillColor=#EDF3FB;strokeColor=#7890A3;fontColor=#243B4D;">
          <mxGeometry x="40" y="120" width="260" height="108" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" vertex="1" value="&lt;b&gt;C：账户与执行&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Account / EVM&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;Transaction · Receipt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=10;fillColor=#EDF3FB;strokeColor=#7890A3;fontColor=#243B4D;">
