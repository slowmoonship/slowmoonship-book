        <mxCell id="n0" parent="1" vertex="1" value="&lt;b&gt;Avalanche 主网&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Avalanche Mainnet&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:16px&quot;&gt;包含多个网络组织&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=PingFang SC;fontSize=21;align=center;verticalAlign=middle;spacing=10;fillColor=#EDF3FB;strokeColor=#7890A3;fontColor=#243B4D;">
